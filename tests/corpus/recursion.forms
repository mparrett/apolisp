(set-global! factorial (fn factorial [n acc] (if (< n 2) acc (factorial (- n 1) (* acc n)))))
(println (factorial 20 1))
(set-global! count-to (fn count-to [i limit] (if (< i limit) (count-to (+ i 1) limit) i)))
(println (count-to 0 100000))
(set-global! sum-to (fn sum-to [n] (if (< n 1) 0 (+ n (sum-to (- n 1))))))
(println (sum-to 100))
(set-global! adder (fn [by] (fn [x] (+ x by))))
(println ((adder 40) 2))
(set-global! tally (fn [head & others] (list head others)))
(println (tally 1 2 3))
(println (tally 1))
