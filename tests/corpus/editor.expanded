(quote defn)
(quote cond)
(set-global! inc (fn inc [n] (+ n 1)))
(set-global! dec (fn dec [n] (- n 1)))
(set-global! max2 (fn max2 [a b] (if (> a b) a b)))
(set-global! min2 (fn min2 [a b] (if (< a b) a b)))
(set-global! clamp (fn clamp [lo hi n] (max2 lo (min2 hi n))))
(set-global! new-state (fn new-state [filename lines] {:lines (if (empty? lines) [""] lines) :cursor-row 0 :cursor-col 0 :goal-col 0 :scroll-row 0 :scroll-col 0 :scroll-sub 0 :wrap? true :filename filename :modified? false :message nil :pending nil :help? true :quit? false}))
(set-global! line-count (fn line-count [state] (count (get state :lines))))
(set-global! line-at (fn line-at [state row] (nth (get state :lines) row)))
(set-global! current-line (fn current-line [state] (line-at state (get state :cursor-row))))
(set-global! line-len (fn line-len [state row] (str-scalar-len (line-at state row))))
(set-global! move-vert (fn move-vert [state row] (assoc state :cursor-row row :cursor-col (min2 (get state :goal-col) (line-len state row)))))
(set-global! touch (fn touch [state] (assoc state :modified? true)))
(set-global! insert-str (fn insert-str [state s] (let [row (get state :cursor-row) col (get state :cursor-col) line (current-line state) next (str (str-scalar-slice line 0 col) s (str-scalar-slice line col (str-scalar-len line)))] (touch (assoc state :lines (assoc (get state :lines) row next) :cursor-col (+ col (str-scalar-len s)))))))
(set-global! split-line (fn split-line [state] (let [row (get state :cursor-row) col (get state :cursor-col) line (current-line state) lines (get state :lines) before (vec-slice lines 0 row) after (vec-slice lines (inc row) (count lines)) head (str-scalar-slice line 0 col) tail (str-scalar-slice line col (str-scalar-len line))] (touch (assoc state :lines (vec (concat before [head] [tail] after)) :cursor-row (inc row) :cursor-col 0)))))
(set-global! join-prev (fn join-prev [state] (let [row (get state :cursor-row) lines (get state :lines) prev (line-at state (dec row)) merged (str prev (current-line state))] (touch (assoc state :lines (vec (concat (vec-slice lines 0 (dec row)) [merged] (vec-slice lines (inc row) (count lines)))) :cursor-row (dec row) :cursor-col (str-scalar-len prev))))))
(set-global! delete-back (fn delete-back [state] (let [row (get state :cursor-row) col (get state :cursor-col)] (if (> col 0) (let [line (current-line state) next (str (str-scalar-slice line 0 (dec col)) (str-scalar-slice line col (str-scalar-len line)))] (touch (assoc state :lines (assoc (get state :lines) row next) :cursor-col (dec col)))) (if (> row 0) (join-prev state) (if true state nil))))))
(set-global! move-left (fn move-left [state] (let [col (get state :cursor-col) row (get state :cursor-row)] (if (> col 0) (assoc state :cursor-col (dec col)) (if (> row 0) (assoc state :cursor-row (dec row) :cursor-col (line-len state (dec row))) (if true state nil))))))
(set-global! move-right (fn move-right [state] (let [col (get state :cursor-col) row (get state :cursor-row)] (if (< col (line-len state row)) (assoc state :cursor-col (inc col)) (if (< row (dec (line-count state))) (assoc state :cursor-row (inc row) :cursor-col 0) (if true state nil))))))
(set-global! wrapped-down (fn wrapped-down [state w] (let [row (get state :cursor-row) line (current-line state) sub (quot (get state :cursor-col) w) goal (get state :goal-col)] (if (< (inc sub) (wrap-height w line)) (assoc state :cursor-col (min2 (str-scalar-len line) (+ (* (inc sub) w) goal))) (if (< (inc row) (line-count state)) (let [nl (line-at state (inc row))] (assoc state :cursor-row (inc row) :cursor-col (min2 (str-scalar-len nl) goal))) (if true state nil))))))
(set-global! wrapped-up (fn wrapped-up [state w] (let [row (get state :cursor-row) line (current-line state) sub (quot (get state :cursor-col) w) goal (get state :goal-col)] (if (> sub 0) (assoc state :cursor-col (min2 (str-scalar-len line) (+ (* (dec sub) w) goal))) (if (> row 0) (let [pl (line-at state (dec row)) start (* (dec (wrap-height w pl)) w)] (assoc state :cursor-row (dec row) :cursor-col (min2 (str-scalar-len pl) (+ start goal)))) (if true state nil))))))
(set-global! move-up (fn move-up [state w] (if (get state :wrap?) (wrapped-up state w) (if (> (get state :cursor-row) 0) (move-vert state (dec (get state :cursor-row))) state))))
(set-global! move-down (fn move-down [state w] (if (get state :wrap?) (wrapped-down state w) (if (< (get state :cursor-row) (dec (line-count state))) (move-vert state (inc (get state :cursor-row))) state))))
(set-global! line-start (fn line-start [state] (assoc state :cursor-col 0)))
(set-global! line-end (fn line-end [state] (assoc state :cursor-col (line-len state (get state :cursor-row)))))
(set-global! global-keymap {"left" [:command :move-left] "right" [:command :move-right] "up" [:command :move-up] "down" [:command :move-down] "C-a" [:command :line-start] "C-e" [:command :line-end] "RET" [:command :newline] "DEL" [:command :delete-back] "C-o" [:command :save] "C-g" [:command :toggle-help] "C-w" [:command :toggle-wrap] "C-x" [:prefix {"C-c" [:command :quit] "C-s" [:command :save]}]})
(set-global! restates-goal {:move-left true :move-right true :line-start true :line-end true :newline true :delete-back true})
(set-global! restate-goal (fn restate-goal [state w] (assoc state :goal-col (if (get state :wrap?) (rem (get state :cursor-col) w) (get state :cursor-col)))))
(set-global! apply-command (fn apply-command [state w c] (if (= c :move-left) (move-left state) (if (= c :move-right) (move-right state) (if (= c :move-up) (move-up state w) (if (= c :move-down) (move-down state w) (if (= c :line-start) (line-start state) (if (= c :line-end) (line-end state) (if (= c :newline) (split-line state) (if (= c :delete-back) (delete-back state) (if (= c :quit) (assoc state :quit? true) (if (= c :toggle-help) (assoc state :help? (not (get state :help?))) (if (= c :toggle-wrap) (assoc state :wrap? (not (get state :wrap?)) :scroll-col 0 :scroll-sub 0) (if (= c :save) (assoc state :save-requested? true) (if true (assoc state :message (str "no command " c)) nil)))))))))))))))
(set-global! run-command (fn run-command [state w c] (let [next (apply-command state w c)] (if (get restates-goal c) (restate-goal next w) next))))
(set-global! printable? (fn printable? [chord] (= (str-scalar-len chord) 1)))
(set-global! dispatch (fn dispatch [state w chord] (let [pending (get state :pending) table (if (= pending nil) global-keymap pending) hit (get table chord) state (assoc state :message nil :pending nil)] (if (= hit nil) (if (let [v__1 (= pending nil)] (if v__1 (printable? chord) v__1)) (restate-goal (insert-str state chord) w) (assoc state :message (str chord " is undefined"))) (if (= (nth hit 0) :prefix) (assoc state :pending (nth hit 1)) (if true (run-command state w (nth hit 1)) nil))))))
(set-global! clip (fn clip [w s] (if (<= (str-scalar-len s) w) s (if (< w 1) "" (if true (str (str-scalar-slice s 0 (dec w)) ">") nil)))))
(set-global! shows-help? (fn shows-help? [state rows] (let [v__1 (get state :help?)] (if v__1 (>= rows 3) v__1))))
(set-global! text-rows (fn text-rows [state rows] (max2 1 (if (shows-help? state rows) (- rows 2) (dec rows)))))
(set-global! help-line (fn help-line [state cols] (clip cols "C-o save  C-x C-c quit  C-g hide")))
(set-global! wrap-height (fn wrap-height [w s] (inc (quot (str-scalar-len s) w))))
(set-global! wrap-seg (fn wrap-seg [w s i] (let [n (str-scalar-len s) from (min2 (* i w) n) to (min2 (+ from w) n)] (str-scalar-slice s from to))))
(set-global! line-height (fn line-height [state w row] (if (>= row (line-count state)) 1 (if (get state :wrap?) (wrap-height w (line-at state row)) 1))))
(set-global! screen-offset (fn screen-offset [state w srow ssub crow csub] (if (= srow crow) (- csub ssub) (loop [r (inc srow) acc (- (line-height state w srow) ssub)] (if (>= r crow) (+ acc csub) (recur (inc r) (+ acc (line-height state w r))))))))
(set-global! screen-advance (fn screen-advance [state w row sub k] (loop [r row s sub n k] (if (< n 1) [r s] (let [h (line-height state w r)] (if (< (inc s) h) (recur r (inc s) (dec n)) (if (< (inc r) (line-count state)) (recur (inc r) 0 (dec n)) (if true [r s] nil))))))))
(set-global! scroll-axis (fn scroll-axis [pos start avail] (if (< pos start) pos (if (>= pos (+ start avail)) (inc (- pos avail)) (if true start nil)))))
(set-global! scroll-to-cursor (fn scroll-to-cursor [state cols rows] (let [w (max2 1 cols) avail (text-rows state rows)] (if (not (get state :wrap?)) (assoc state :scroll-sub 0 :scroll-row (scroll-axis (get state :cursor-row) (get state :scroll-row) avail) :scroll-col (scroll-axis (get state :cursor-col) (get state :scroll-col) w)) (let [state (assoc state :scroll-col 0) crow (get state :cursor-row) csub (quot (get state :cursor-col) w) srow (get state :scroll-row) ssub (get state :scroll-sub)] (if (let [v__2 (< crow srow)] (if v__2 v__2 (let [v__1 (= crow srow)] (if v__1 (< csub ssub) v__1)))) (assoc state :scroll-row crow :scroll-sub csub) (let [off (screen-offset state w srow ssub crow csub)] (if (< off avail) state (let [adv (screen-advance state w srow ssub (inc (- off avail)))] (assoc state :scroll-row (nth adv 0) :scroll-sub (nth adv 1)))))))))))
(set-global! screen-rows (fn screen-rows [state w avail] (loop [r (get state :scroll-row) sub (get state :scroll-sub) out []] (if (>= (count out) avail) out (if (>= r (line-count state)) (recur r sub (conj out "")) (let [line (line-at state r)] (if (>= sub (line-height state w r)) (recur (inc r) 0 out) (recur r (inc sub) (conj out (if (get state :wrap?) (wrap-seg w line sub) (window (get state :scroll-col) w line)))))))))))
(set-global! cursor-screen (fn cursor-screen [state w] (if (get state :wrap?) [(screen-offset state w (get state :scroll-row) (get state :scroll-sub) (get state :cursor-row) (quot (get state :cursor-col) w)) (rem (get state :cursor-col) w)] [(- (get state :cursor-row) (get state :scroll-row)) (- (get state :cursor-col) (get state :scroll-col))])))
(set-global! window (fn window [left w s] (let [n (str-scalar-len s) vis (clip w (str-scalar-slice s (min2 left n) n))] (if (let [v__2 (= left 0)] (if v__2 v__2 (< (str-scalar-len vis) 1))) vis (str "<" (str-scalar-slice vis 1 (str-scalar-len vis)))))))
(set-global! status-line (fn status-line [state cols] (let [name (if (= (get state :filename) nil) "*scratch*" (get state :filename)) flag (if (get state :modified?) " *" "") pos (str " " (inc (get state :cursor-row)) ":" (inc (get state :cursor-col))) msg (if (= (get state :message) nil) "" (str "  " (get state :message)))] (clip cols (str name flag pos msg)))))
(set-global! frame (fn frame [state cols rows] (let [state (scroll-to-cursor state cols rows) w (max2 1 cols) avail (text-rows state rows) body (join "\n" (screen-rows state w avail)) foot (if (shows-help? state rows) (str (help-line state cols) "\n" (status-line state cols)) (status-line state cols))] (str body "\n" foot))))
(set-global! script ["h" "e" "l" "l" "o" "RET" "w" "o" "r" "l" "d" "C-a" "!" "up" "C-e" "?" "DEL" "down" "C-e" "RET" "z" "RET" "l" "o" "n" "g" "e" "r" "up" "up" "C-x" "C-c"])
(set-global! final (reduce (fn [st c] (dispatch st 32 c)) (new-state "demo.txt" [""]) script))
(println "--- frame")
(println (frame final 32 6))
(println "--- lines")
(println (str (get final :lines)))
(println (str "quit? " (get final :quit?) "  modified? " (get final :modified?)))
(println "--- frame at 2 rows")
(println (frame final 32 2))
(set-global! geometry (fn geometry [rows] (let [sq (scroll-to-cursor final 32 rows)] (println (str "rows " rows "  text-rows " (text-rows final rows) "  help " (shows-help? final rows) "  scroll-row " (get sq :scroll-row) "  cursor-row " (get sq :cursor-row))))))
(println "--- geometry as the height collapses")
(geometry 3)
(geometry 2)
(geometry 1)
(println "--- frame at 10 rows, buffer of 4")
(println (frame final 32 10))
(println (str "frame lines " (count (split "\n" (frame final 32 10))) " for 10 rows"))
(set-global! home (assoc final :cursor-col 0 :goal-col 0 :scroll-col 0 :wrap? false))
(println "--- frame at 5 columns")
(println (frame home 5 6))
(println (str "widths " (str (map (fn [l] (str-scalar-len l)) (split "\n" (frame home 5 6)))) " (each must be 5 or less)"))
(println (str "clip 1 [" (clip 1 "abcdef") "]  clip 0 [" (clip 0 "abcdef") "]"))
(set-global! wide-line "0123456789abcdefghijklmnopqrstuvwxyz")
(set-global! wide-state (assoc (new-state "d.txt" [wide-line "short"]) :wrap? false))
(set-global! at-col (fn at-col [col] (let [st (scroll-to-cursor (assoc wide-state :cursor-col col) 12 4) left (get st :scroll-col) screen (- col left)] (println (str "col " col "  scroll " left "  screen " screen (if (let [v__1 (>= screen 0)] (if v__1 (< screen 12) v__1)) "  on-screen" "  OFF-SCREEN") "  [" (window left 12 wide-line) "]")))))
(println "--- horizontal scroll, 36 chars through a 12-column window")
(at-col 0)
(at-col 11)
(at-col 12)
(at-col 20)
(at-col 36)
(set-global! wrapped (assoc (new-state "d.txt" [wide-line "tail"]) :wrap? true))
(println "--- wrapped frame, 12 columns")
(println (frame wrapped 12 8))
(set-global! wrapped-at (fn wrapped-at [col] (let [st (scroll-to-cursor (assoc wrapped :cursor-col col) 12 8) at (cursor-screen st 12)] (println (str "col " col "  screen-row " (nth at 0) "  screen-col " (nth at 1) (if (let [v__1 (>= (nth at 1) 0)] (if v__1 (< (nth at 1) 12) v__1)) "  on-screen" "  OFF-SCREEN"))))))
(println "--- wrapped cursor")
(wrapped-at 0)
(wrapped-at 11)
(wrapped-at 12)
(wrapped-at 25)
(wrapped-at 36)
(println "--- wrapped down/up move screen rows, not buffer rows")
(set-global! trace (fn trace [label st] (println (str label "  row " (get st :cursor-row) "  col " (get st :cursor-col)))))
(set-global! w0 (restate-goal (assoc wrapped :cursor-row 0 :cursor-col 25) 12))
(trace "start        " w0)
(set-global! w1 (move-down w0 12))
(trace "after down   " w1)
(set-global! w2 (move-down w1 12))
(trace "after down   " w2)
(set-global! w3 (move-down w2 12))
(trace "after down   " w3)
(set-global! w4 (move-down w3 12))
(trace "onto line 2  " w4)
(trace "back up      " (move-up w4 12))
(set-global! u0 (restate-goal (assoc wrapped :wrap? false :cursor-row 0 :cursor-col 3) 12))
(trace "unwrapped    " u0)
(trace "after down   " (move-down u0 12))
